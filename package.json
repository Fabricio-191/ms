{
	"name": "@fabricio-191/ms",
	"version": "2.0.0",
	"type": "module",
	"exports": {
		".": {
			"import": {
				"types": "./lib/esm/index.d.ts",
				"default": "./lib/esm/index.js"
			},
			"require": {
				"types": "./lib/cjs/index.d.cts",
				"default": "./lib/cjs/index.cjs"
			}
		}
	},
	"scripts": {
		"lint": "eslint ./ --fix",
		"check:types": "tsc --noEmit",
		"prepare": "npm run transpile",
		"transpile": "tsup",
		"test": "npm run transpile && node --experimental-vm-modules node_modules/jest/bin/jest.js",
		"bench": "npm run transpile && tsx benchmarks/index.ts",
		"bench:jit": "node --allow-natives-syntax --import tsx/esm benchmarks/jit.ts",
		"build": "npm run lint && npm run check:types && npm run transpile"
	},
	"engines": {
		"node": ">=18.0.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@stylistic/eslint-plugin": "^5.8.0",
		"@types/benchmark": "^2.1.1",
		"@types/jest": "^30.0.0",
		"@types/ms": "^0.7.31",
		"@types/node": "^22.0.0",
		"assemblyscript": "^0.28.10",
		"benchmark": "^2.1.4",
		"eslint": "^10.0.0",
		"jest": "^30.0.0",
		"jiti": "^2.6.1",
		"ms": "^2.1.3",
		"tinybench": "^6.0.0",
		"ts-jest": "^29.4.6",
		"tsup": "^8.5.1",
		"tsx": "^4.21.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.56.0"
	},
	"homepage": "https://github.com/Fabricio-191/ms#readme",
	"repository": {
		"type": "git",
		"url": "https://github.com/Fabricio-191/ms",
		"email": "fabricio19110@gmail.com"
	},
	"bugs": {
		"url": "https://github.com/Fabricio-191/ms/issues"
	},
	"author": {
		"name": "Fabricio-191",
		"email": "fabricio19110@gmail.com",
		"url": "https://github.com/Fabricio-191/"
	},
	"license": "Apache License 2.0",
	"description": "Tiny millisecond conversion utility",
	"keywords": [
		"ms",
		"conversion",
		"parse",
		"parsing"
	],
	"funding": {
		"type": "patreon",
		"url": "https://www.patreon.com/fabricio_191"
	}
}
